{
    "kind": "ExtensionDefinition",
    "schemaVersion": "1.1",
    "name": "Incus",
    "label": "incus",
    "extensionType": "application",
    "vendor": "MetalSoft",
    "extensionVersion": "1.1.2",
    "description": "Provide the installation and lifecycle management of an Incus cluster with various options",
    "icon": "https://avatars.githubusercontent.com/u/2301756?s=200&v=4",
    "dependencies": {
        "controllerVersion": "release-v7.2",
        "osTemplates": [
            "incus-ubuntu-22-04-cluster-node",
            "incus-ubuntu-24-04-cluster-node"
        ]
    },
    "inputs": [
        {
            "label": "cluster_server_type",
            "name": "cluster_server_type",
            "inputType": "ExtensionInputServerType",
            "options": {
                "vendor": "Dell"
            }
        },
        {
            "label": "cluster_instance_count",
            "name": "cluster_instance_count",
            "inputType": "ExtensionInputInteger",
            "defaultValue": 1,
            "options": {
                "minValue": 1,
                "maxValue": 50
            }
        },
        {
            "label": "cluster_node_os_template",
            "name": "cluster_node_os_template",
            "inputType": "ExtensionInputOsTemplate",
            "options": {
                "osFamily": "Ubuntu"
            }
        },
        {
            "label": "cluster_enabled",
            "name": "cluster_enabled",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": true,
            "options": {}
        },
        {
            "label": "install_ui",
            "name": "install_ui",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": true,
            "options": {}
        },
        {
            "label": "storage_driver",
            "name": "storage_driver",
            "helpText": "Storage backend for the default pool: dir, btrfs, lvm, lvmcluster, zfs, ceph, cephfs or cephobject.",
            "inputType": "ExtensionInputString",
            "defaultValue": "dir",
            "options": {
                "validationRegEx": "^(dir|btrfs|lvm|lvmcluster|zfs|ceph|cephfs|cephobject)$"
            }
        }
    ],
    "outputs": [
        {
            "label": "cluster_api_url",
            "name": "cluster_api_url",
            "outputType": "string"
        },
        {
            "label": "cluster_ui_url",
            "name": "cluster_ui_url",
            "outputType": "string"
        },
        {
            "label": "cluster_members",
            "name": "cluster_members",
            "outputType": "string"
        },
        {
            "label": "cluster_member_count",
            "name": "cluster_member_count",
            "outputType": "string"
        },
        {
            "label": "cluster_storage_driver",
            "name": "cluster_storage_driver",
            "outputType": "string"
        },
        {
            "label": "incus_release",
            "name": "incus_release",
            "outputType": "string"
        }
    ],
    "infrastructure": {
        "instanceArrays": [
            {
                "label": "incus",
                "instanceCount": "#/input/cluster_instance_count",
                "serverType": "#/input/cluster_server_type",
                "osTemplate": "#/input/cluster_node_os_template",
                "logicalNetworks": [
                    {
                        "label": "incus-mgmt",
                        "networkConnection": {
                            "tagged": true,
                            "accessMode": "l2",
                            "redundancy": {
                                "mode": "active-active",
                                "implementation": {
                                    "implementationType": "distributed-link-aggregation"
                                }
                            },
                            "providesDefaultRoute": true,
                            "dns": {
                                "provisionInstanceDnsRecords": true
                            }
                        }
                    }
                ],
                "tags": [
                    "incus_cluster"
                ]
            }
        ],
        "logicalNetworks": [
            {
                "label": "incus-mgmt",
                "profileLabel": "incus-mgmt"
            }
        ]
    },
    "assets": [
        {
            "label": "incus-ansible-bundle",
            "name": "incus-ansible-bundle",
            "assetType": "AnsibleBundle",
            "url": "https://repo.metalsoft.io/.extensions_ms/incus/incus-v1.1.1.zip"
        },
        {
            "label": "ee-incus-1-1-0",
            "name": "ee-incus-1-1-0",
            "assetType": "OciImage",
            "url": "https://repo.metalsoft.io/.extensions_ms/ee/ee-incus-1.1.0.tar.gz",
            "repositoryRegistry": "registry.metalsoft.dev",
            "namespaceRegistry": "ee-incus",
            "tagRegistry": "1.1.0"
        }
    ],
    "onCreate": [
        {
            "stage": "preDeploy",
            "tasks": []
        },
        {
            "stage": "postDeploy",
            "tasks": [
                {
                    "label": "initial-incus-deployment",
                    "taskType": "ExtensionTaskAnsible",
                    "options": {
                        "asset": "incus-ansible-bundle",
                        "playbook": "deploy.yaml",
                        "ee": "ee-incus-1-1-0",
                        "executionTimeout": 3600,
                        "executionTimeoutTick": 30
                    }
                }
            ]
        }
    ],
    "onEdit": [
        {
            "stage": "preDeploy",
            "tasks": [
                {
                    "label": "scale-incus",
                    "taskType": "ExtensionTaskAnsible",
                    "options": {
                        "asset": "incus-ansible-bundle",
                        "playbook": "scale.yaml",
                        "ee": "ee-incus-1-1-0",
                        "executionTimeout": 3600,
                        "executionTimeoutTick": 30
                    }
                }
            ]
        },
        {
            "stage": "postDeploy",
            "tasks": [
                {
                    "label": "upgrade-incus",
                    "taskType": "ExtensionTaskAnsible",
                    "options": {
                        "asset": "incus-ansible-bundle",
                        "playbook": "upgrade.yaml",
                        "ee": "ee-incus-1-1-0",
                        "executionTimeout": 3600,
                        "executionTimeoutTick": 30
                    }
                },
                {
                    "label": "scale-incus",
                    "taskType": "ExtensionTaskAnsible",
                    "options": {
                        "asset": "incus-ansible-bundle",
                        "playbook": "scale.yaml",
                        "ee": "ee-incus-1-1-0",
                        "executionTimeout": 3600,
                        "executionTimeoutTick": 30
                    }
                }
            ]
        }
    ],
    "onDelete": [],
    "configVars": [
        {
            "label": "DNSResolvers",
            "name": "DNSResolvers",
            "helpText": "Comma-separated DNS resolver IPs handed to every cluster node (systemd-resolved).",
            "inputType": "ExtensionInputString",
            "setOnly": false,
            "hidden": false,
            "isPassword": false,
            "defaultValue": "1.1.1.1",
            "options": {}
        },
        {
            "label": "branch_release",
            "name": "branch_release",
            "helpText": "Zabbly package channel to install/track: daily, stable or lts-6.0.",
            "inputType": "ExtensionInputString",
            "defaultValue": "stable",
            "options": {}
        },
        {
            "label": "images_auto_update_interval",
            "name": "images_auto_update_interval",
            "helpText": "Interval in hours at which cached images are auto-updated.",
            "inputType": "ExtensionInputInteger",
            "defaultValue": 6,
            "options": {
                "minValue": 1,
                "maxValue": 72
            }
        },
        {
            "label": "core_https_port",
            "name": "core_https_port",
            "helpText": "HTTPS port the Incus API listens on.",
            "inputType": "ExtensionInputInteger",
            "defaultValue": 8443,
            "options": {}
        },
        {
            "label": "separate_api_and_cluster_traffic",
            "name": "separate_api_and_cluster_traffic",
            "helpText": "When true, cluster traffic uses a dedicated port (API port + 1) instead of sharing the API address.",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": false,
            "options": {}
        },
        {
            "label": "cluster_member_upgrade_enabled",
            "name": "cluster_member_upgrade_enabled",
            "helpText": "When true, edit deployments apply OS/package upgrades to existing members one node at a time before scaling.",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": false,
            "options": {}
        },
        {
            "label": "cluster_member_force_remove_enabled",
            "name": "cluster_member_force_remove_enabled",
            "helpText": "When true, scale-in force-removes a member that stays offline after evacuation.",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": false,
            "options": {}
        },
        {
            "label": "vars_debugging_enabled",
            "name": "vars_debugging_enabled",
            "helpText": "When true, playbooks print the resolved extension variables for debugging.",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": false,
            "options": {}
        }
    ]
}
