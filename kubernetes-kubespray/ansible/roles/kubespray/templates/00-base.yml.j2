# Generated by kubernetes-kubespray {{ k8s_ext_version }} — wrapper-owned kubespray variables.
# Loaded first; 50-site.yml and 90-site-overrides.yml come after it; zz-owned.yml wins over all.
# Defaults a site admin may override (site_kubespray_overrides) live here.

# containerd: docker.io through Google's public mirror first (Docker Hub anonymous pull limits are
# per source IP and tenant clusters share NAT addresses), Docker Hub as fallback
containerd_registries_mirrors:
  - prefix: docker.io
    mirrors:
      - host: https://mirror.gcr.io
        capabilities: ["pull", "resolve"]
        skip_verify: false
      - host: https://registry-1.docker.io
        capabilities: ["pull", "resolve"]
        skip_verify: false
download_retries: 8
local_path_provisioner_helper_image_tag: "1.38.0"
kubeadm_backup_retention_count: {{ k8s_backup_retention }}
etcd_backup_retention_count: {{ k8s_backup_retention }}
