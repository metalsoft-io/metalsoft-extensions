# Generated by kubernetes-kubespray {{ k8s_ext_version }} — wrapper-owned, loaded last (wins).
# Never edit on the nodes; site_kubespray_overrides cannot set any of these.
{% set co = k8s_effective_create_only %}

# API endpoint: kube-vip ARP VIP on every control-plane node. With loadbalancer_apiserver defined,
# kube_apiserver_endpoint is the VIP on ALL hosts and no nginx-proxy is deployed on workers.
kube_vip_enabled: true
kube_vip_controlplane_enabled: true
kube_vip_arp_enabled: true
kube_vip_services_enabled: false
kube_vip_address: "{{ k8s_vip }}"
loadbalancer_apiserver:
  address: "{{ k8s_vip }}"
  port: 6443
supplementary_addresses_in_ssl_keys: {{ ([k8s_vip] + ([k8s_api_fqdn_candidate] if k8s_api_fqdn_candidate else [])) | to_json }}

# Network (create-only values come from the recorded snapshot after create)
kube_network_plugin: calico
kube_network_plugin_multus: false
calico_network_backend: vxlan
calico_vxlan_mode: Always
calico_ipip_mode: Never
calico_nftable_mode: "{{ 'Enabled' if co.kube_proxy_mode == 'nftables' else 'Disabled' }}"
kube_proxy_mode: "{{ co.kube_proxy_mode }}"
kube_proxy_strict_arp: true
kube_pods_subnet: "{{ co.pod_network_cidr }}"
kube_service_addresses: "{{ co.service_network_cidr }}"
cluster_name: "{{ co.cluster_dns_domain }}"
enable_nodelocaldns: true
upstream_dns_servers: {{ k8s_effective_site.dns | to_json }}

# Runtime, etcd, certificates
container_manager: containerd
etcd_deployment_type: host
etcd_retries: 10
kube_encrypt_secret_data: true
auto_renew_certificates: {{ k8s_effective_site.renew | bool | to_json }}

# Host management stays with the OS template and the wrapper
ntp_enabled: false
override_system_hostname: false
system_upgrade: false

# Add-ons (MetalLB is wrapper-managed: kubespray's role is 0.13.9, CRDs break on k8s 1.36)
metrics_server_enabled: {{ k8s_effective_addons.metrics_server | bool | to_json }}
local_path_provisioner_enabled: {{ k8s_effective_addons.local_path_provisioner | bool | to_json }}
local_path_provisioner_is_default_storageclass: "true"
gateway_api_enabled: {{ k8s_effective_addons.gateway_api_crds | bool | to_json }}
metallb_enabled: false
helm_enabled: false

# Nothing is written to or run from the EE beyond its container-local scratch dir
credentials_dir: "{{ k8s_ks_dir }}/credentials"
artifacts_dir: "{{ k8s_ks_dir }}/ks-artifacts"
kubeconfig_localhost: false
kubectl_localhost: false
download_run_once: false
download_localhost: false
unsafe_show_logs: false
