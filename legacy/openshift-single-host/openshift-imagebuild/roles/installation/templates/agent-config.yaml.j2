apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: {{ extensionInstanceRecordSet.extensionInstanceName }}
{% set rendezvous = namespace(ip='', gateway='', prefix=24) -%}
{%- if extensionInstanceVariables.number_masters == 1 and extensionInstanceVariables.number_workers == 0 -%}
{%- for cluster_ip in extensionInstanceRecordSet.clusterIpv4Ips | default([]) -%}
{%- if cluster_ip.tags and cluster_ip.tags.role == 'api-vip' -%}
{%- set rendezvous.ip = cluster_ip.ip -%}
{%- set rendezvous.gateway = cluster_ip.gateway -%}
{%- set rendezvous.prefix = cluster_ip.maskBits -%}
{%- endif -%}
{%- endfor -%}
{%- else -%}
{%- for instance in extensionInstanceRecordSet.serverInstances -%}
{%- for ip in instance.ipv4Ips -%}
{%- if ip.isDefaultGateway and not rendezvous.ip -%}
{%- set rendezvous.ip = ip.ip -%}
{%- set rendezvous.gateway = ip.gateway -%}
{%- set rendezvous.prefix = ip.maskBits -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- endif -%}
rendezvousIP: {{ rendezvous.ip }}
hosts:
{%- for instance in extensionInstanceRecordSet.serverInstances -%}
{%- set inst_data = namespace(ip='', gateway='', prefix=24, interface_mac='') -%}
{%- if extensionInstanceVariables.number_masters == 1 and extensionInstanceVariables.number_workers == 0 -%}
{%- set inst_data.ip = rendezvous.ip -%}
{%- set inst_data.gateway = rendezvous.gateway -%}
{%- set inst_data.prefix = rendezvous.prefix -%}
{%- else -%}
{%- for ip in instance.ipv4Ips -%}
{%- if ip.isDefaultGateway and not inst_data.ip -%}
{%- set inst_data.ip = ip.ip -%}
{%- set inst_data.gateway = ip.gateway -%}
{%- set inst_data.prefix = ip.maskBits -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- for physicalInterfaceNetworkConfig in instance.networkConfig.physicalInterfaceNetworkConfigs.values() -%}
{%- if extensionInstanceVariables.number_masters == 1 and extensionInstanceVariables.number_workers == 0 -%}
{%- if inst_data.interface_mac == '' -%}
{%- set inst_data.interface_mac = physicalInterfaceNetworkConfig.macAddress -%}
{%- endif -%}
{%- else -%}
{%- for interfaceIpv4Address in physicalInterfaceNetworkConfig.ipv4Addresses -%}
{%- if interfaceIpv4Address.ip == inst_data.ip and inst_data.interface_mac == '' -%}
{%- set inst_data.interface_mac = physicalInterfaceNetworkConfig.macAddress -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endfor %}

  - hostname: instance-{{ instance.serverInstanceId }}
    role: {{ 'master' if instance.tags is defined and 'master-node' in instance.tags else 'worker' }}
    interfaces:
      - name: ocp0
        macAddress: {{ inst_data.interface_mac }}
    networkConfig:
      interfaces:
        - name: ocp0
          type: ethernet
          state: up
          mac-address: {{ inst_data.interface_mac }}
          mtu: {{ extensionInstanceVariables.mtu | default(1500) }}
          ipv4:
            enabled: true
            address:
              - ip: {{ inst_data.ip }}
                prefix-length: {{ inst_data.prefix }}
            dhcp: false
      dns-resolver:
        config:
          server:
            - {{ extensionInstanceRecordSet.dnsResolverIp }}
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: {{ inst_data.gateway }}
            next-hop-interface: ocp0
            table-id: 254
{%- endfor -%}