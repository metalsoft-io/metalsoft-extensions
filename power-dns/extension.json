{
  "kind": "ExtensionDefinition",
  "schemaVersion": "1.1",
  "name": "powerdns-automation",
  "label": "powerdnsautomation",
  "extensionType": "workflow",
  "vendor": "MetalSoft",
  "extensionVersion": "1.1.0",
  "description": "Manages DNS records via PowerDNS API during server lifecycle",
  "icon": "dns",
  "dependencies": {
    "controllerVersion": "string"
  },
  "inputs": [],
  "outputs": [],
  "assets": [
    {
      "label": "power-dns-configuration",
      "name": "power-dns-configuration",
      "assetType": "Bundle",
      "url": "https://repo.metalsoft.io/.extensions_ms/workflows/powerdns_v1.1.zip"
    }
  ],
  "onAssetChange": [
    {
      "stage": "serverInstanceGroupUpdateDNS",
      "tasks": [
        {
          "label": "update-dns-records-for-instance-group",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    },
    {
      "stage": "serverInstanceUpdateDNS",
      "tasks": [
        {
          "label": "update-dns-records-for-instance",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    },
    {
      "stage": "clusterUpdateDNS",
      "tasks": [
        {
          "label": "update-dns-records-for-cluster",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    },
    {
      "stage": "serverCreateDNS",
      "tasks": [
        {
          "label": "create-dns-and-ptr-records-for-server",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    },
    {
      "stage": "serverDeleteDNS",
      "tasks": [
        {
          "label": "delete-dns-and-ptr-records-for-server",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    },
    {
      "stage": "switchCreateDNS",
      "tasks": [
        {
          "label": "create-dns-and-ptr-records-for-switch",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    },
    {
      "stage": "switchDeleteDNS",
      "tasks": [
        {
          "label": "delete-dns-and-ptr-records-for-switch",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "power-dns-configuration",
            "playbook": "deploy_dns_flexible.yaml"
          }
        }
      ]
    }
  ]
}
