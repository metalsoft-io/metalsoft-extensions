{
  "kind": "ExtensionDefinition",
  "schemaVersion": "1.1",
  "name": "execute-on-ssh",
  "label": "execute-on-ssh",
  "extensionType": "workflow",
  "vendor": "MetalSoft",
  "extensionVersion": "1.0.0",
  "description": "Execute a simple command over ssh",
  "icon": "",
  "dependencies": {
    "controllerVersion": "string"
  },
  "inputs": [],
  "outputs": [],
  "assets": [
    {
      "label": "test_playbook",
      "name": "test playbook",
      "assetType": "AnsibleBundle",
      "url": "https://repo.metalsoft.io/.extensions_ms/workflows/ansible.zip"
    }
  ],
  "onAssetChange": [
    {
      "stage": "serverRegistered",
      "tasks": [
        {
          "label": "test workflow",
          "taskType": "ExtensionTaskAnsible",
          "options": {
            "asset": "test_ansible",
            "playbook": "test_playbook.yaml"
          }
        }
      ]
    },
  ]
}
