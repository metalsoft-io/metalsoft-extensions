{
    "kind": "ExtensionDefinition",
    "schemaVersion": "1.1",
    "name": "VMware Cloud Foundation (VCF)",
    "label": "vcf",
    "extensionType": "application",
    "vendor": "MetalSoft",
    "extensionVersion": "1.0",
    "description": "VMware Cloud Foundation (VCF)",
    "icon": "https://www.vmware.com/media/blt8c9a8aaca0ffd4ac/blt457d6175bb71af84/66bb256a1257f5d926b3e22e/vmw-prod-icon-cloud-foundation1.svg",
    "dependencies": {
        "controllerVersion": "release-v7.0",
        "osTemplates": [
            "esxi-8-24280767-cluster-node",
            "esxi-8-24859861-cluster-node"
        ]
    },
    "inputs": [
        {
            "label": "mgmt_domain_cluster_node_server_type",
            "name": "mgmt_domain_cluster_node_server_type",
            "inputType": "ExtensionInputServerType",
            "options": {}
        },
        {
            "label": "vi_workload_domain_cluster_node_server_type",
            "name": "vi_workload_domain_cluster_node_server_type",
            "inputType": "ExtensionInputServerType",
            "options": {}
        },
        {
            "label": "mgmt_domain_instance_count",
            "name": "mgmt_domain_instance_count",
            "inputType": "ExtensionInputInteger",
            "defaultValue": 4,
            "options": {
                "minValue": 4,
                "maxValue": 6
            }
        },
        {
            "label": "vi_workload_domain_instance_count",
            "name": "vi_workload_domain_instance_count",
            "inputType": "ExtensionInputInteger",
            "defaultValue": 0,
            "options": {
                "minValue": 0,
                "maxValue": 10
            }
        },
        {
            "label": "mgmt_domain_cluster_node_os_template",
            "name": "mgmt_domain_cluster_node_os_template",
            "inputType": "ExtensionInputOsTemplate",
            "options": {
                "osFamily": "ESXi"
            }
        },
        {
            "label": "vi_workload_domain_cluster_node_os_template",
            "name": "vi_workload_domain_cluster_node_os_template",
            "inputType": "ExtensionInputOsTemplate",
            "options": {
                "osFamily": "ESXi"
            }
        },
        {
            "label": "deployment_architecture_model",
            "name": "deployment_architecture_model",
            "inputType": "ExtensionInputString",
            "defaultValue": "consolidated",
            "options": {}
        },
        {
            "label": "repository_base_url",
            "name": "repository_base_url",
            "inputType": "ExtensionInputString",
            "options": {}
        },
        {
            "label": "nsx_manager_size",
            "name": "nsx_manager_size",
            "inputType": "ExtensionInputString",
            "isPassword": false,
            "defaultValue": "medium",
            "options": {}
        },
        {
            "label": "vcenter_vm_size",
            "name": "vcenter_vm_size",
            "inputType": "ExtensionInputString",
            "isPassword": false,
            "defaultValue": "small",
            "options": {}
        },
        {
            "label": "cba_admin_password",
            "name": "cba_admin_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "Q#ZT1N#uarLPoPd",
            "options": {}
        },
        {
            "label": "cba_root_password",
            "name": "cba_root_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "SALkFJ8e8x69?Of",
            "options": {}
        },
        {
            "label": "sddc_root_password",
            "name": "sddc_root_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "h1C^L#zoENSqfu2",
            "options": {}
        },
        {
            "label": "sddc_local_admin_password",
            "name": "sddc_local_admin_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "a9C$E#zoTNSqfj7",
            "options": {}
        },
        {
            "label": "sddc_second_user_password",
            "name": "sddc_second_user_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "BAtdNYmg?vcZ8Oa",
            "options": {}
        },
        {
            "label": "nsx_manager_root_password",
            "name": "nsx_manager_root_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "#kCKefi$2@otD^m",
            "options": {}
        },
        {
            "label": "nsx_manager_admin_password",
            "name": "nsx_manager_admin_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "oIt@KT5!1B1TQ7t",
            "options": {}
        },
        {
            "label": "nsx_manager_audit_password",
            "name": "nsx_manager_audit_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "ytpc7H8XdqD$A2e",
            "options": {}
        },
        {
            "label": "vcenter_root_password",
            "name": "vcenter_root_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "sQZBOfys6^Y?4wv",
            "options": {}
        },
        {
            "label": "vcenter_sso_admin_password",
            "name": "vcenter_sso_admin_password",
            "inputType": "ExtensionInputString",
            "isPassword": true,
            "defaultValue": "FLgdLdBX@zih9I8",
            "options": {}
        },
        {
            "label": "validation_debug",
            "name": "validation_debug",
            "inputType": "ExtensionInputBoolean",
            "defaultValue": false,
            "options": {}
        }
    ],
    "outputs": [],
    "infrastructure": {
        "instanceArrays": [
            {
                "label": "management",
                "instanceCount": "#/input/mgmt_domain_instance_count",
                "serverType": "#/input/mgmt_domain_cluster_node_server_type",
                "osTemplate": "#/input/mgmt_domain_cluster_node_os_template",
                "logicalNetworks": [
                    {
                        "label": "vcf-mgmt",
                        "networkConnection": {
                            "tagged": true,
                            "accessMode": "l2",
                            "redundancy": {
                                "mode": "active-active"
                            },
                            "providesDefaultRoute": true,
                            "dns": {
                                "provisionInstanceDnsRecords": true
                            }
                        }
                    },
                    {
                        "label": "vcf-vsan",
                        "networkConnection": {
                            "tagged": true,
                            "accessMode": "l2",
                            "disableAutoIpAllocation": true,
                            "redundancy": {
                                "mode": "active-active"
                            }
                        }
                    },
                    {
                        "label": "vcf-vmotion",
                        "networkConnection": {
                            "tagged": true,
                            "accessMode": "l2",
                            "disableAutoIpAllocation": true,
                            "redundancy": {
                                "mode": "active-active"
                            }
                        }
                    },
                    {
                        "label": "vcf-nsx",
                        "networkConnection": {
                            "tagged": true,
                            "accessMode": "l2",
                            "disableAutoIpAllocation": true,
                            "redundancy": {
                                "mode": "active-active"
                            }
                        }
                    }
                ],
                "customVariables": [
                    {
                        "name": "sddc_root_username",
                        "value": "root"
                    },
                    {
                        "name": "sddc_local_admin_username",
                        "value": "admin@local"
                    },
                    {
                        "name": "sddc_second_username",
                        "value": "vcf"
                    },
                    {
                        "name": "nsx_manager_root_username",
                        "value": "root"
                    },
                    {
                        "name": "nsx_manager_admin_username",
                        "value": "admin"
                    },
                    {
                        "name": "nsx_manager_audit_username",
                        "value": "audit"
                    },
                    {
                        "name": "vcenter_root_username",
                        "value": "root"
                    },
                    {
                        "name": "vcenter_sso_admin_username",
                        "value": "administrator@vsphere.local"
                    }
                ],
                "tags": [
                    "mgmt_domain"
                ]
            }
        ],
        "logicalNetworks": [
            {
                "label": "vcf-mgmt",
                "profileLabel": "vcf-mgmt",
                "ipAllocations": [
                    {
                        "tags": {
                            "role": "cloud-builder"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "cba.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    },
                    {
                        "tags": {
                            "role": "sddc-manager"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "sddc.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    },
                    {
                        "tags": {
                            "role": "management-vcenter-server"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "m-vcs1.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    },
                    {
                        "tags": {
                            "role": "nsx-manager-vip"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "m-nsx1.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    },
                    {
                        "tags": {
                            "role": "nsx-manager-node1"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "m-nsx1a.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    },
                    {
                        "tags": {
                            "role": "nsx-manager-node2"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "m-nsx1b.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    },
                    {
                        "tags": {
                            "role": "nsx-manager-node3"
                        },
                        "ipVersion": "ipv4",
                        "dnsRecords": [
                            {
                                "name": "m-nsx1c.{{default_zone_name}}",
                                "recordType": "A",
                                "generatePtrRecord": true,
                                "ttl": 3600
                            }
                        ]
                    }
                ]
            },
            {
                "label": "vcf-vsan",
                "profileLabel": "vcf-vsan",
                "ipRanges": [
                    {
                        "tags": {
                            "role": "vsan-pool"
                        },
                        "ipVersion": "ipv4",
                        "ipCount": 4
                    }
                ]
            },
            {
                "label": "vcf-vmotion",
                "profileLabel": "vcf-vmotion",
                "ipRanges": [
                    {
                        "tags": {
                            "role": "vmotion-pool"
                        },
                        "ipVersion": "ipv4",
                        "ipCount": 4
                    }
                ]
            },
            {
                "label": "vcf-nsx",
                "profileLabel": "vcf-nsx",
                "ipRanges": [
                    {
                        "tags": {
                            "role": "nsx-host-overlay-pool"
                        },
                        "ipVersion": "ipv4",
                        "ipCount": 8
                    }
                ]
            }
        ]
    },
    "assets": [
        {
            "label": "vcf",
            "name": "vcf",
            "assetType": "Bundle",
            "url": "https://repo.metalsoft.io/.extensions_ms/vmware-cloud-foundation/vmware-cloud-foundation-v1.0.1.zip"
        }
    ],
    "onCreate": [
        {
            "stage": "preDeploy",
            "tasks": []
        },
        {
            "stage": "postDeploy",
            "tasks": [
                {
                    "label": "initial-vcf-deployment",
                    "taskType": "ExtensionTaskAnsible",
                    "options": {
                        "asset": "vcf",
                        "playbook": "deploy.yaml"
                    }
                }
            ]
        }
    ],
    "onEdit": [],
    "onDelete": []
}