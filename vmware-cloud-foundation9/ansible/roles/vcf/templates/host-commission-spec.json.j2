{# Callers may override the host list (commission_hosts) and target pool
   (commission_network_pool_id / commission_network_pool_name) — e.g. the workload domain
   flow; defaults preserve the management scale-out behavior. #}
[
{% for host in commission_hosts_effective | default(commission_hosts) | default(groups['management_scale_out']) %}
    {
        "fqdn": "{{ host }}",
        "username": "{{ hostvars[host].ansible_user }}",
        "password": "{{ hostvars[host].ansible_password }}",
{# NOTE: verify storageType enum against the live SDDC Manager 9.x API (/v1/hosts/validations) — VSAN_ESA expected for ESA clusters #}
{% if vsan_spec.esa_config is defined and vsan_spec.esa_config | bool %}
        "storageType": "VSAN_ESA",
{% else %}
        "storageType": "VSAN",
{% endif %}
        "networkPoolId": "{{ commission_network_pool_id | default(management_network_pool_id) }}",
{% if not (vcf.skip_esx_thumbprint_validation | default(false) | bool) %}
        "sshThumbprint": "{{ hostvars[host].esxi_ssh_thumbprint | default('') }}",
        "sslThumbprint": "{{ hostvars[host].esxi_ssl_thumbprint | default('') }}",
{% endif %}
        "networkPoolName": "{{ commission_network_pool_name | default(management_pool_name) }}"
    }{% if not loop.last %},{% endif %}

{% endfor %}
]
